# Database (PostgreSQL with pgvector support, Neon or Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_case_db?schema=public"

# Authentication & Security Secrets
AUTH_SECRET="super_secret_jwt_auth_key_sih_2026_prototype"
JWT_SECRET="super_secret_jwt_auth_key_sih_2026_prototype"

# Node.js AES-256-GCM Encryption Key (64 hex characters / 32 bytes)
ENCRYPTION_KEY="636173655f6d616e6167656d656e745f7365637265745f6b65795f323032363038323830"

# Storage Configuration (Vercel Blob / Private Blob Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_dummy_token_for_local_dev"

# OCR Settings
OCR_ENABLED="true"

# AI Embeddings Provider (options: 'openai', 'huggingface', 'local_mock_vectors')
EMBEDDING_PROVIDER="huggingface"
OPENAI_API_KEY=""
HUGGINGFACE_API_KEY=""

# AI LLM (Optional)
LLM_ENABLED="false"
LLM_API_KEY=""

# Limits
MAX_UPLOAD_SIZE_MB="50"
